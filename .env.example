# Copy to .env for docker compose. Environment values are read directly by the binary.
NLD_MODE=demo
NLD_BIND=127.0.0.1:8080
NLD_DATA_DIR=./data
# Browser-visible origin, without a path. Set this to the HTTPS origin behind nginx.
NLD_PUBLIC_URL=http://127.0.0.1:8080
NLD_MAX_SANDBOXES=300
NLD_MAX_DB_TASKS=16
NLD_SANDBOX_TTL_HOURS=24
# Production: e.g. smtps://username:password@smtp.example.org:465
# Credentials must be provided through the deployment's secret store.
NLD_SMTP_URL=
NLD_SMTP_FROM=Nauru Leave Desk <noreply@nauru.example>
# Separate 32-byte key file, generated with gen-backup-key; never store with backups.
NLD_BACKUP_KEY_FILE=
# Enable only when a trusted reverse proxy replaces X-Forwarded-For.
NLD_TRUST_PROXY_HEADERS=false
RUST_LOG=info
# Per-IP limits. Government offices often share one NAT address, so keep these generous.
NLD_RATE_PER_SEC=30
NLD_SANDBOX_CREATIONS_PER_HOUR=30

# Production file uploads require ClamAV clamd TCP INSTREAM; no address = 503 scanner_unavailable.
# With the optional compose service: NLD_CLAMD_ADDR=clamav:3310
NLD_CLAMD_ADDR=
# Connection/stream timeout in milliseconds; positive integer.
NLD_CLAMD_TIMEOUT_MS=10000
